    "cache-loader": "4.1.0",
    "core-js": "3.50.0",
    "css-loader": "7.1.5",
    "node-polyfill-webpack-plugin": "4.1.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "@rancher/cypress": "1.0.7",
    "cypress": "15.19.0",
