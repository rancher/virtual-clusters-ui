{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "allowJs": true,
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    // Must stay false so a `yarn link`ed @rancher/shell resolves to its real
    // checkout. Left symlinked it appears under node_modules, where TS will not
    // infer types from its plain .js modules (config/table-headers etc) and
    // falls back to the ambient stubs in shell.d.ts. No-op for a normal install.
    "preserveSymlinks": false,
    "typeRoots": [
      "../../node_modules",
      "../../node_modules/@rancher/shell/types",
      "../../node_modules/@types",
    ],
    "types": [
      "node",
      "rancher",
      "shell"
    ],
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "paths": {
      "@shell/*": [
        "../../node_modules/@rancher/shell/*"
      ],
      // same directory the shell's pkg/vue.config.js aliases @components to
      "@components/*": [
        "../../node_modules/@rancher/shell/rancher-components/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts",
    "**/*.tsx",
    "**/*.vue"
  ],
  "exclude": [
    "../../node_modules",
    "**/*.test.ts",
  ]
}