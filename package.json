    "eslint-plugin-local-rules": "link:./eslint-plugin-local-rules",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.7.0",
    "neostandard": "0.13.0",
    "typescript-eslint": "8.70.0",
    "@types/node": "25.3.3"
  },
  "resolutions": {
    "**/webpack": "5",
