{
  "name": "virtual-clusters",
  "version": "1.3.0-rc2",
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@babel/plugin-transform-class-static-block": "7.29.14",
    "@rancher/components": "0.3.0-alpha.4",
    "@rancher/shell": "v3.0.16-rc.1",
    "@types/lodash": "4.17.27",
    "cache-loader": "4.1.0",
    "core-js": "3.51.0",
    "css-loader": "7.1.5",
    "node-polyfill-webpack-plugin": "4.1.0",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "@rancher/cypress": "1.0.12",
    "cypress": "15.19.0",
    "eslint-plugin-cypress": "4.3.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-local-rules": "link:./eslint-plugin-local-rules",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "neostandard": "0.13.0",
    "typescript-eslint": "8.73.0",
    "vue-eslint-parser": "10.4.1",
    "@types/node": "25.3.3"
  },
  "resolutions": {
    "**/webpack": "5",
    "typescript-eslint": "8.73.0",
    "@yarnpkg/core": "4.9.1",
    "@tootallnate/once": "2.0.1",
    "basic-ftp": "6.2.4",
    "cookie": "0.7.2",
    "**/diff2html/diff": "5.2.2",
    "fast-xml-parser": "5.12.0",
    "markdown-it": "14.3.3",
    "**/patch-package/tmp": "0.2.7",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.2.1",
    "qs": "6.16.1",
    "serialize-javascript": "7.1.4",
    "**/simple-update-notifier/semver": "7.8.6",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.6"
  },
  "scripts": {
    "dev": "NODE_ENV=dev ./node_modules/.bin/vue-cli-service serve",
    "build": "./node_modules/.bin/vue-cli-service build",
    "clean": "./node_modules/@rancher/shell/scripts/clean",
    "build-pkg": "./node_modules/@rancher/shell/scripts/build-pkg.sh",
    "serve-pkgs": "./node_modules/@rancher/shell/scripts/serve-pkgs",
    "publish-pkgs": "./node_modules/@rancher/shell/scripts/extension/publish",
    "parse-tag-name": "./node_modules/@rancher/shell/scripts/extension/parse-tag-name",
    "lint": "./node_modules/.bin/eslint --max-warnings 0 .",
    "cy:open": "./node_modules/.bin/cypress open --config numTestsKeptInMemory=10",
    "cy:run": "./node_modules/.bin/cypress run",
    "e2e:ci": "./node_modules/.bin/cypress run --browser chrome"
  }
}
